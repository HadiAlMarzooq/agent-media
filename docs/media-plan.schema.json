{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HadiAlMarzooq/agent-media/main/docs/media-plan.schema.json",
  "title": "Agent Media Plan v1",
  "description": "Generated from the canonical Zod Media IR models. Do not edit by hand; regenerate with `node scripts/generate-schema.mjs`.",
  "type": "object",
  "properties": {
    "irVersion": {
      "type": "string",
      "const": "1"
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "maxSizeMB": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "compatibility": {
          "type": "string",
          "enum": ["high", "balanced"]
        },
        "quality": {
          "type": "string",
          "enum": ["high", "balanced", "small"]
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "const": "trim"
              },
              "startSeconds": {
                "type": "number",
                "minimum": 0
              },
              "endSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": ["id", "reason", "operation", "startSeconds"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "const": "reframe"
              },
              "aspectRatio": {
                "type": "string",
                "pattern": "^[1-9]\\d*:[1-9]\\d*$"
              },
              "strategy": {
                "default": "center",
                "type": "string",
                "enum": ["center"]
              }
            },
            "required": ["id", "reason", "operation", "aspectRatio", "strategy"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "const": "resize"
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["id", "reason", "operation", "width", "height"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "const": "encode"
              },
              "profile": {
                "type": "string",
                "enum": ["high-compatibility", "balanced", "high-quality"]
              },
              "maxSizeMB": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": ["id", "reason", "operation", "profile"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "const": "extract-audio"
              },
              "format": {
                "default": "m4a",
                "type": "string",
                "enum": ["m4a", "mp3", "wav"]
              }
            },
            "required": ["id", "reason", "operation", "format"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "const": "extract-frame"
              },
              "atSeconds": {
                "type": "number",
                "minimum": 0
              },
              "format": {
                "default": "jpg",
                "type": "string",
                "enum": ["jpg", "png"]
              }
            },
            "required": ["id", "reason", "operation", "atSeconds", "format"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "const": "concatenate"
              },
              "inputs": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["id", "reason", "operation", "inputs"],
            "additionalProperties": false
          }
        ]
      }
    },
    "expectations": {
      "type": "object",
      "properties": {
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9]\\d*:[1-9]\\d*$"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxSizeBytes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "audio": {
          "type": "string",
          "enum": ["preserve", "remove", "required"]
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "videoCodec": {
          "type": "string",
          "minLength": 1
        },
        "pixelFormat": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["irVersion", "source", "constraints", "steps", "expectations"],
  "additionalProperties": false
}
