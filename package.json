{
  "name": "agent-media",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Deterministic, verifiable media workflows for software agents.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "demo": "pnpm build && node examples/agent-recovery.mjs",
    "benchmark:reliability": "pnpm build && node benchmarks/reliability.mjs",
    "benchmark:compare": "node benchmarks/compare-reliability.mjs",
    "release:pack": "pnpm build && node scripts/package-release.mjs",
    "release:smoke": "node scripts/smoke-release.mjs",
    "release:publish": "pnpm -r --filter './packages/*' publish --access public",
    "audit:prod": "pnpm audit --prod",
    "check:sizes": "pnpm build && node scripts/check-package-sizes.mjs",
    "generate:schema": "pnpm --filter @hadialmarzooq/agent-media-core build && node scripts/generate-schema.mjs",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
