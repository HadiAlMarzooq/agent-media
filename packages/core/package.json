{
  "name": "@hadialmarzooq/agent-media-core",
  "version": "0.2.0",
  "description": "Versioned media planning and structured verification primitives for software agents.",
  "keywords": [
    "media",
    "agents",
    "media-ir",
    "planning",
    "verification"
  ],
  "homepage": "https://github.com/HadiAlMarzooq/agent-media#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HadiAlMarzooq/agent-media.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/HadiAlMarzooq/agent-media/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema/media-plan.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
